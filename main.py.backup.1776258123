@asynccontextmanager
async def lifespan(app: FastAPI):
    """Application lifespan."""
    print(f"🚀 {APP_NAME} v{APP_VERSION}")
    print(f"   Ollama: {OLLAMA_URL}")
    print(f"   Static: {STATIC_DIR}")
    yield
    print("👋 Shutting down...")


app = FastAPI(
    title=APP_NAME,
    version=APP_VERSION,
    lifespan=lifespan
)

# CORS
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"]
)

