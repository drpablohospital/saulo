# Ollama Configuration (REQUIRED)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_CODING_MODEL=qwen2.5:7b

# Stable Diffusion (OPTIONAL - for image generation)
SD_URL=http://127.0.0.1:7860

# Cloud LLM Fallback (OPTIONAL)
# Get key from: https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions

# Ollama Cloud (OPTIONAL fallback)
OLLAMA_API_KEY=
OLLAMA_CLOUD_URL=https://api.ollama.ai

# Tavily Search (OPTIONAL - for web search)
# Get key from: https://tavily.com/
TAVILY_API_KEY=

# Server Configuration
SAULO_PORT=8090
SAULO_HOST=0.0.0.0

# Public URL (for generated images)
PUBLIC_URL=http://localhost:8090
